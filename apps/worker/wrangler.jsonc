{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "flarechat",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-24",
  "vars": {
    "APP_URL": "https://flarechat.pinara.workers.dev",
    "WEB_ORIGIN": "https://flarechat.pinara.workers.dev",
    "RP_ID": "flarechat.pinara.workers.dev",
    "CLOUDFLARE_ACCOUNT_ID": "deef3884fc0cef219bec7204b097d699",
    "CLOUDFLARE_WORKER_NAME": "flarechat"
  },
  "keep_vars": true,
  "secrets": {
    "required": [
      "CLOUDFLARE_API_TOKEN",
      "CREDENTIAL_MASTER_KEY",
      "CREDENTIAL_MASTER_KEY_VERSION",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET"
    ]
  },
  "unsafe": {
    "metadata": {
      "keep_bindings": [
        "d1",
        "plain_text",
        "json",
        "secret_text",
        "secret_key"
      ]
    }
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.sql"],
      "fallthrough": true
    }
  ],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/oauth/*", "/attendance/*"]
  },
  "d1_databases": [
    {
      "binding": "CONTROL_DB",
      "migrations_dir": "migrations/control"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RECOVERY_RECEIPTS"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "env": {
    "local": {
      "ai": {
        "binding": "AI"
      },
      "d1_databases": [
        {
          "binding": "CONTROL_DB",
          "database_name": "mail-automation-control-local",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "migrations/control"
        },
        {
          "binding": "LOCAL_ORGANIZATION_DB_1",
          "database_name": "flarechat-organization-local-1",
          "database_id": "00000000-0000-0000-0000-000000000101",
          "migrations_dir": "migrations/organization"
        },
        {
          "binding": "LOCAL_ORGANIZATION_DB_2",
          "database_name": "flarechat-organization-local-2",
          "database_id": "00000000-0000-0000-0000-000000000102",
          "migrations_dir": "migrations/organization"
        },
        {
          "binding": "LOCAL_ORGANIZATION_DB_3",
          "database_name": "flarechat-organization-local-3",
          "database_id": "00000000-0000-0000-0000-000000000103",
          "migrations_dir": "migrations/organization"
        }
      ],
      "r2_buckets": [
        {
          "binding": "RECOVERY_RECEIPTS",
          "bucket_name": "mail-automation-recovery-receipts-local"
        }
      ],
      "vars": {
        "APP_URL": "http://localhost:8787",
        "WEB_ORIGIN": "http://localhost:5173",
        "RP_ID": "localhost",
        "GOOGLE_CLIENT_ID": ""
      }
    }
  },
  "observability": {
    "enabled": true
  }
}
